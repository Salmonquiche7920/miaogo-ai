# 全部為「伺服器端」環境變數，不要加 NEXT_PUBLIC_ 前綴，金鑰不會送到瀏覽器。
# 未設定時，App 會自動使用明確標示的「示範資料／降級方案」。

# 生成式 AI（行程文字整理）。未設定 → 使用規則式文字（不影響行程本身）
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_DISABLED=false

# 天氣：auto | cwa | open-meteo | none
#   auto = 有 CWA_API_KEY 用中央氣象署，否則嘗試 Open-Meteo（免金鑰），失敗則顯示「無天氣資料」
WEATHER_PROVIDER=auto
CWA_API_KEY=

# 交通時間：demo（直線距離估算）| google（Google Distance Matrix，需金鑰；失敗自動退回 demo）
TRAVEL_PROVIDER=demo
GOOGLE_MAPS_API_KEY=

# 地圖底圖：osm（OpenStreetMap 圖磚，免金鑰）| none（只顯示內建簡易路線圖）
MAP_PROVIDER=osm
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# 資料來源：demo（內建示範資料）| tdx（交通部 TDX 觀光資料，需金鑰；失敗自動退回 demo）
DATA_PROVIDER=demo
TDX_CLIENT_ID=
TDX_CLIENT_SECRET=
